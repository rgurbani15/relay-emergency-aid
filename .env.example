# RELAY configuration reference.
# Runtime configuration lives in Cloudflare, not in a .env file:
#   - Non-secret vars:  wrangler.jsonc -> "vars"   (DEMO_MODE, AI_MODEL)
#   - Secrets (prod):   npx wrangler secret put VOUCHER_SIGNING_SECRET
#   - Secrets (local):  .dev.vars  (copy from .dev.vars.example)
#
# DEMO_MODE=true                      # enables the synthetic demo sign-in endpoint. Set "false" to disable.
# AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# VOUCHER_SIGNING_SECRET=<random 32+ byte string>   # HMAC key for voucher QR credentials
#
# Optional, for seeding with a fixed anchor date (default: today, UTC):
# SEED_ANCHOR=2026-11-12

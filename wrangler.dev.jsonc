{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "relay",
  // LOCAL DEV CONFIG (no Workers AI binding). Keep in sync with wrangler.jsonc.
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "upload_source_maps": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // D1: create with `npx wrangler d1 create relay-db`, then paste the printed
  // database_id below. The placeholder is only used by local development.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "relay-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "DEMO_MODE": "true",
    // Central Workers AI model id for the Scenario Interpreter.
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },
  "observability": { "enabled": true }
}
